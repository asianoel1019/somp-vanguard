# Copy to .env (same folder) and fill in, or run Set_Password.bat (it creates .env from this file). Never committed.

# ---- Web ----
# The page only listens on 127.0.0.1 (this computer). Open http://127.0.0.1:8444/
PORT=8444

# ---- Signing key ----
# The private key made by scripts\License_Keygen.bat. Keep it on this computer only.
KEY_FILE=C:\somp-license-keys\k1-private.pem
# Key ID: must match a public key built into backend\lib\licenseKeys.js (the app refuses to start otherwise)
KEY_ID=k1

# ---- Output ----
# Folder for the issued .lic files (default: "issued" next to KEY_FILE)
ISSUED_DIR=C:\somp-license-keys\issued
# Registry of issued licenses, shared with License_Issue.bat (default: issued-licenses.md next to KEY_FILE)
# REGISTRY_FILE=C:\somp-license-keys\issued-licenses.md

# ---- Sign-in ----
# scrypt hash of the sign-in password. Do not type it by hand: run Set_Password.bat.
PASSWORD_HASH=
