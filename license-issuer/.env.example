# Copy to .env (same folder) and fill in, or run Set_Password.bat (it creates .env from this file). Never committed.

# ---- Web ----
# The page only listens on 127.0.0.1 (this computer). Open http://127.0.0.1:8444/
PORT=8444

# ---- Signing key ----
# The private key made by scripts\License_Keygen.bat. Keep it on this computer only.
KEY_FILE=C:\somp-license-keys\k1-private.pem
# Key ID: must match a public key built into backend\lib\licenseKeys.js (the app refuses to start otherwise)
KEY_ID=k1

# ---- Output ----
# Folder for the issued .lic files (default: "issued" next to KEY_FILE)
ISSUED_DIR=C:\somp-license-keys\issued
# Database of customers, sales people and issued licenses, shared with License_Issue.bat (default: license-issuer.db next to KEY_FILE)
# DB_FILE=C:\somp-license-keys\license-issuer.db
# Registry of issued licenses: a read-only copy generated from the database after every change (default: issued-licenses.md next to KEY_FILE)
# REGISTRY_FILE=C:\somp-license-keys\issued-licenses.md

# ---- Vendor contact ----
# Defaults for the Vendor / Contact email fields of the Issue form (both optional; each license signs what the form holds).
# The product shows them to the customer's users for renewals. Invalid values stop the app at startup.
# CONTACT_VENDOR=Example Vendor
# CONTACT_EMAIL=support@example.test

# ---- Email (optional) ----
# Delivery mails to customers (with the .lic attached), the test mail (Settings > Email) and the weekly expiry digest.
# Without SMTP_HOST and MAIL_FROM (or with an invalid value) mail is disabled and the page says why; everything else works.
# SMTP_PORT defaults to 587. SMTP_SECURE=true: TLS from the start (usually port 465); false: STARTTLS when the server offers it.
# SMTP_USER / SMTP_PASS only when the server needs a login. SMTP_PASS is never shown on the page, in responses or in logs.
# MAIL_FROM: an address, or "Name <address>". MAIL_ADMIN: one address; gets the weekly summary and, by default, the test mail.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=license-issuer@example.test
# SMTP_PASS=
# MAIL_FROM=SOMP License Issuer <license-issuer@example.test>
# MAIL_ADMIN=licenses@example.test

# ---- Sign-in ----
# scrypt hash of the sign-in password. Do not type it by hand: run Set_Password.bat.
PASSWORD_HASH=
