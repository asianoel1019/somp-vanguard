# Copy to .env (same folder) and fill in. .env is never committed.

# ---- Web ----
PORT=8443
# HTTPS certificate (.pfx) and its password. Required unless ALLOW_HTTP=true.
HTTPS_PFX_PATH=C:\pwdchange\certs\pwdchange.pfx
HTTPS_PFX_PASSPHRASE=
# true = plain HTTP for a short trial only (the page shows a warning). Never in production.
ALLOW_HTTP=false
# Networks that may open the page (CIDR or single addresses, comma separated). Empty = the server does not start.
ALLOWED_NETS=10.0.0.0/8,192.168.0.0/16
# true only when a reverse proxy in front adds X-Forwarded-For
TRUST_PROXY=false

# ---- Active Directory ----
# Domain controller or domain name (empty = the computer's own domain)
AD_SERVER=dc01.example.test
# Service account: an ordinary domain user is enough (changing a password with the old one needs no rights)
AD_SERVICE_USER=EXAMPLE\svc-pwdchange
AD_SERVICE_PWD=
# Accounts that may use the page: OU DNs separated by ; (with sub-OUs). Use the same OUs as PWD_NOTIFY_OUS in Vanguard.
# Empty = every enabled account in the domain. Administrators (adminCount=1), krbtgt and the service account never.
ALLOWED_OUS=OU=Staff,DC=example,DC=test

# ---- Page text ----
# Shown under "forgot your password / locked / disabled": who to contact
ADMIN_CONTACT=IT Helpdesk ext. 1234, it-helpdesk@example.test

# ---- Optional: "your password was changed" mail to the user ----
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PWD=
SMTP_FROM=it-noreply@example.test

# ---- Audit log folder (one file per day) ----
# LOG_DIR=C:\pwdchange\logs
